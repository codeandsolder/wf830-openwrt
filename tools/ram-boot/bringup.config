# SPDX-License-Identifier: GPL-2.0-only
# Intentional ARMv7 single-core GDM7243QT RAM-only bring-up essentials.
# This is a KCONFIG_ALLCONFIG seed for Linux 6.12 allnoconfig.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_CPU_V7=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_GENERIC_CLOCKEVENTS=y
CONFIG_HZ_PERIODIC=y
CONFIG_HZ_1000=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_COMMON_CLK=y
CONFIG_GPIOLIB=y
CONFIG_GPIOLIB_IRQCHIP=y
CONFIG_OF_GPIO=y
CONFIG_PINCTRL=y
CONFIG_PINMUX=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="console=ttyGDM0,921600n8 earlycon nohz=off rdinit=/init loglevel=8"
CONFIG_CMDLINE_FORCE=y
CONFIG_GDM7243_IRQCHIP=y
CONFIG_GDM7243_RTCCS=y
CONFIG_GDM7243_TIMER=y
CONFIG_GPIO_GDM7243=y
CONFIG_PINCTRL_GDM7243=y
CONFIG_CLK_GDM7243=y
CONFIG_SERIAL_GDM7243_EARLYCON=y
CONFIG_SERIAL_GDM7243=y
CONFIG_SERIAL_GDM7243_CONSOLE=y
